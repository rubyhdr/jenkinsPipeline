# Non-secret staging settings. Secrets (SECRET_KEY, DB password) come from Jenkins credentials.
APP_ENV=staging
SEED_DEMO_DATA=true
LOAN_PERIOD_DAYS=14
MAX_ACTIVE_LOANS=5
LATE_FEE_PER_DAY=0.50
JWT_EXPIRY_MINUTES=60
# Enables /_chaos/* endpoints so alerting can be tested before production.
CHAOS_ENABLED=true
