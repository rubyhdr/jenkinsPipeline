# Non-secret production settings. Secrets (SECRET_KEY, DB password) come from Jenkins credentials.
APP_ENV=production
# Demo catalogue so the assessor sees a populated library; set to false for a real deployment.
SEED_DEMO_DATA=true
LOAN_PERIOD_DAYS=14
MAX_ACTIVE_LOANS=5
LATE_FEE_PER_DAY=0.50
JWT_EXPIRY_MINUTES=30
# Incident simulation for the assignment demo (scripts/simulate_incident.py errors).
# Set to false for a real production deployment.
CHAOS_ENABLED=true
